<?xml version="1.0"?>
<robot name="three_wheel_robot"
    xmlns:xacro="http://ros.org/wiki/xacro">

    <!-- Materials -->
    <material name="wheel_color">
        <color rgba="0.1 0.1 0.1 1"/>
    </material>

    <material name="baby_blue">
        <color rgba="0.68 0.85 0.90 1.0"/>
    </material>

    <!-- Base Link -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.3 0.4 0.1"/>
            </geometry>
            <material name="baby_blue"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.3 0.4 0.1"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="5.0"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0833" ixy="0.0" ixz="0.0" iyy="0.0625" iyz="0.0" izz="0.1458"/>
        </inertial>
    </link>

    <!-- LiDAR Link -->
    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.05"/>
            </geometry>
            <material name="wheel_color"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.05"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.00025"/>
        </inertial>
    </link>

    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="0.0 0.0 0.08" rpy="0 0 0"/>
    </joint>

    <!-- IMU Link -->
    <link name="imu_link">
        <inertial>
            <mass value="0.01"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
        </inertial>
    </link>

    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Right Back Wheel -->
    <link name="right_back_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.07" length="0.04"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 1.5708 0"/>
            <material name="wheel_color"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.07" length="0.04"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 1.5708 0"/>
        </collision>
        <inertial>
            <mass value="0.5"/>
            <origin xyz="0 0 0" rpy="0 1.5708 0"/>
            <inertia ixx="0.0012" ixy="0.0" ixz="0.0" iyy="0.0024" iyz="0.0" izz="0.0012"/>
        </inertial>
    </link>

    <joint name="right_back_base" type="continuous">
        <parent link="base_link"/>
        <child link="right_back_wheel"/>
        <origin xyz="0.17 -0.09 -0.03" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
    </joint>

    <!-- Left Back Wheel -->
    <link name="left_back_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.07" length="0.04"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 1.5708 0"/>
            <material name="wheel_color"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.07" length="0.04"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 1.5708 0"/>
        </collision>
        <inertial>
            <mass value="0.5"/>
            <origin xyz="0 0 0" rpy="0 1.5708 0"/>
            <inertia ixx="0.0012" ixy="0.0" ixz="0.0" iyy="0.0024" iyz="0.0" izz="0.0012"/>
        </inertial>
    </link>

    <joint name="left_back_base" type="continuous">
        <parent link="base_link"/>
        <child link="left_back_wheel"/>
        <origin xyz="-0.17 -0.09 -0.03" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
    </joint>

    <!-- Support Wheel (Front Caster) -->
    <link name="support_wheel">
        <visual>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
            <material name="wheel_color"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.2"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0002"/>
        </inertial>
    </link>

    <joint name="support_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="support_wheel"/>
        <origin xyz="0.01 0.1 -0.05" rpy="0 0 0"/>
    </joint>

    <!-- Gazebo Plugins -->
    <gazebo reference="base_link">
        <material>Gazebo/Blue</material>
    </gazebo>

    <gazebo reference="right_back_wheel">
        <material>Gazebo/Black</material>
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>

    <gazebo reference="left_back_wheel">
        <material>Gazebo/Black</material>
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>

    <gazebo reference="support_wheel">
        <material>Gazebo/Black</material>
        <mu1>0.1</mu1>
        <mu2>0.1</mu2>
    </gazebo>

    <!-- Differential Drive Plugin -->
    <gazebo>
        <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
            <ros>
                <namespace>/</namespace>
                <remapping>cmd_vel:=cmd_vel</remapping>
                <remapping>odom:=odom</remapping>
            </ros>
            <update_rate>30</update_rate>
            <left_joint>left_back_base</left_joint>
            <right_joint>right_back_base</right_joint>
            <wheel_separation>0.44</wheel_separation>
            <wheel_diameter>0.14</wheel_diameter>
            <max_wheel_torque>20</max_wheel_torque>
            <max_wheel_acceleration>1.0</max_wheel_acceleration>
            <command_topic>cmd_vel</command_topic>
            <odometry_topic>odom</odometry_topic>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_link</robot_base_frame>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_wheel_tf>true</publish_wheel_tf>
        </plugin>
    </gazebo>

    <!-- LiDAR Sensor + Plugin -->
    <gazebo reference="lidar_link">
        <sensor type="ray" name="lidar_sensor">
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.3</min>
                    <max>15</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>
            <plugin name="gazebo_ros_laser_controller" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <remapping>~/out:=scan</remapping>
                </ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>lidar_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>

    <!-- IMU Sensor + Plugin -->
    <gazebo reference="imu_link">
        <sensor type="imu" name="imu_sensor">
            <pose>0 0 0 0 0 0</pose>
            <update_rate>100</update_rate>
            <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
                <ros>
                    <remapping>~/out:=imu</remapping>
                </ros>
                <frame_name>imu_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>

</robot>
